{
  "name": "chase-statement-downloader",
  "version": "1.0.0",
  "description": "Automated Chase Bank statement downloader",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test && bun run format:check",
    "typecheck": "tsc --noEmit",
    "start": "bun src/chaseAutoDownloader.ts",
    "bulk": "bun src/chaseAutoDownloader.ts --bulk",
    "dev": "bun src/chaseAutoDownloader.ts",
    "dev:bulk": "bun src/chaseAutoDownloader.ts --bulk",
    "lint": "bun run --bun eslint src/**/*.ts",
    "format": "bun run --bun prettier --write .",
    "format:check": "bun run --bun prettier --check .",
    "test": "bun test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
